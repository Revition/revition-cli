{
  "name": "revition-cli-workspace",
  "private": true,
  "description": "Revition CLI workspace root",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node scripts/test-all.mjs",
    "build": "pnpm -r --if-present run build",
    "check:actions": "node scripts/check-pinned-actions.mjs",
    "check:changesets": "node scripts/check-changesets.mjs",
    "check:install-scripts": "node scripts/check-install-scripts.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:size": "node scripts/check-size.mjs",
    "changeset": "changeset",
    "e2e:phase1": "node --import tsx --test --test-timeout=300000 e2e/phase1.e2e.ts",
    "rehearsal": "node --import tsx --test --test-timeout=300000 \"e2e/rehearsal/*.rehearsal.test.ts\"",
    "version-packages": "changeset version && node scripts/release-notes.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.3"
    }
  }
}
