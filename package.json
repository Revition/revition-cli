{
  "name": "revition-cli-workspace",
  "private": true,
  "description": "Revition CLI workspace root",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node --test \"scripts/*.test.mjs\" && node --import tsx --test \"legacy-parity/*.test.mjs\" && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "check:actions": "node scripts/check-pinned-actions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "tsx": "4.23.15"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.3"
    }
  }
}
