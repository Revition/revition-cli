{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/branches.status.v1.json",
  "title": "revition branches status --json",
  "x-schema-id": "revition.branches.status.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "branches:status"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string"
            },
            "branchId": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "reviewedBy": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "pipeline": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stage": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "detail",
                  "stage",
                  "status"
                ],
                "additionalProperties": true
              }
            },
            "artifactRef": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "reviewUrl": {
              "type": "string"
            }
          },
          "required": [
            "agentId",
            "artifactRef",
            "branchId",
            "pipeline",
            "reviewUrl",
            "reviewedBy",
            "status"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
