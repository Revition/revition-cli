{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/agents.runs.v1.json",
  "title": "revition agents runs --json",
  "x-schema-id": "revition.agents.runs.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "agents:runs"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string"
            },
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "runId": {
                    "type": "string"
                  },
                  "workTitle": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "inFlight": {
                    "type": "boolean"
                  },
                  "startedMs": {
                    "type": "number"
                  },
                  "endedMs": {
                    "type": "number"
                  },
                  "traceRef": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "costUsd": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "costNote": {
                    "type": "string"
                  }
                },
                "required": [
                  "costNote",
                  "costUsd",
                  "inFlight",
                  "runId",
                  "startedMs",
                  "status",
                  "traceRef",
                  "workTitle"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "agentId",
            "runs"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
