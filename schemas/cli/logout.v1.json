{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/logout.v1.json",
  "title": "revition logout --json",
  "x-schema-id": "revition.logout.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "logout"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "profile": {
                    "type": "string"
                  },
                  "host": {
                    "type": "string"
                  },
                  "hadSession": {
                    "type": "boolean"
                  },
                  "auth0Revoked": {
                    "type": "boolean"
                  },
                  "sessionRevoked": {
                    "type": "boolean"
                  },
                  "queued": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "auth0Revoked",
                  "hadSession",
                  "host",
                  "profile",
                  "queued",
                  "sessionRevoked"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "results"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
