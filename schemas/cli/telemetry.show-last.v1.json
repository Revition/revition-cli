{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/telemetry.show-last.v1.json",
  "title": "revition telemetry show-last --json",
  "x-schema-id": "revition.telemetry.show-last.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "telemetry:show-last"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "installId": {
                    "type": "string"
                  },
                  "cliVersion": {
                    "type": "string"
                  },
                  "os": {
                    "enum": [
                      "darwin",
                      "linux",
                      "win32"
                    ]
                  },
                  "nodeMajor": {
                    "type": "number"
                  },
                  "command": {
                    "type": "string"
                  },
                  "flagsUsed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "exitCode": {
                    "type": "number"
                  },
                  "durationMs": {
                    "type": "number"
                  },
                  "ci": {
                    "type": "boolean"
                  },
                  "timestamp": {
                    "type": "string"
                  }
                },
                "required": [
                  "ci",
                  "cliVersion",
                  "command",
                  "durationMs",
                  "exitCode",
                  "flagsUsed",
                  "installId",
                  "nodeMajor",
                  "os",
                  "schemaVersion",
                  "timestamp"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "events"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
