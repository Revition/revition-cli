{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/branches.list.v1.json",
  "title": "revition branches list --json",
  "x-schema-id": "revition.branches.list.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "branches:list"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string"
            },
            "branches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "agentId": {
                    "type": "string"
                  },
                  "origin": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string"
                  },
                  "reviewedBy": {
                    "type": "string"
                  },
                  "pipeline": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "stage": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "detail": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "detail",
                        "stage",
                        "status"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "artifactRef": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "at": {
                          "type": "string"
                        },
                        "by": {
                          "type": "string"
                        },
                        "event": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "at",
                        "by",
                        "event"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "branch": {
                    "type": "string"
                  },
                  "branchId": {
                    "type": "string"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "testsAdded": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "permissionDiff": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "permission": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "permission"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "impact": {
                    "type": "object",
                    "properties": {
                      "permission": {},
                      "data": {
                        "type": "object",
                        "properties": {
                          "expanded": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "reduced": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "expanded",
                          "reduced"
                        ],
                        "additionalProperties": true
                      },
                      "ai": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "ui": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "cost": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "security": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "risky": {
                        "type": "boolean"
                      },
                      "flags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "ai",
                      "cost",
                      "data",
                      "flags",
                      "permission",
                      "risky",
                      "security",
                      "ui"
                    ],
                    "additionalProperties": true
                  }
                },
                "required": [
                  "agentId",
                  "branch",
                  "branchId",
                  "createdAt",
                  "files",
                  "origin",
                  "permissionDiff",
                  "status",
                  "summary"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "agentId",
            "branches"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
