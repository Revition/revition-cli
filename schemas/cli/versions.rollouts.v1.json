{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/versions.rollouts.v1.json",
  "title": "revition versions rollouts --json",
  "x-schema-id": "revition.versions.rollouts.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "versions:rollouts"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "appId": {
              "type": "string"
            },
            "rollouts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "channel": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "previous": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "plan": {
                    "type": "object",
                    "properties": {
                      "stages": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "stages"
                    ],
                    "additionalProperties": true
                  },
                  "stageIndex": {
                    "type": "number"
                  },
                  "status": {
                    "enum": [
                      "complete",
                      "halted",
                      "rolling"
                    ]
                  }
                },
                "required": [
                  "channel",
                  "plan",
                  "previous",
                  "stageIndex",
                  "status",
                  "version"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "appId",
            "rollouts"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
