{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/assist.v1.json",
  "title": "revition assist --json",
  "x-schema-id": "revition.assist.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "assist"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "ask",
                "edit"
              ]
            },
            "turns": {
              "type": "number"
            },
            "status": {
              "type": "string"
            },
            "spentCredits": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "budgetCredits": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "stoppedByUser": {
              "type": "boolean"
            },
            "text": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tool": {
                    "type": "string"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "ok",
                  "tool"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "actions",
            "budgetCredits",
            "mode",
            "sessionId",
            "spentCredits",
            "status",
            "stoppedByUser",
            "text",
            "turns"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
