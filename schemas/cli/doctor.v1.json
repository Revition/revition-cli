{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/doctor.v1.json",
  "title": "revition doctor --json",
  "x-schema-id": "revition.doctor.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "doctor"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "fail",
                      "ok",
                      "warn"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "hint": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "hint",
                  "id",
                  "message",
                  "status"
                ],
                "additionalProperties": true
              }
            },
            "summary": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "number"
                },
                "warn": {
                  "type": "number"
                },
                "fail": {
                  "type": "number"
                }
              },
              "required": [
                "fail",
                "ok",
                "warn"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "checks",
            "summary"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
