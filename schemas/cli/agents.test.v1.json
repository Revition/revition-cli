{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/agents.test.v1.json",
  "title": "revition agents test --json",
  "x-schema-id": "revition.agents.test.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "agents:test"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string"
            },
            "quote": {
              "type": "object",
              "properties": {
                "quoteId": {
                  "type": "string"
                },
                "draftVersion": {
                  "type": "number"
                },
                "modelCalls": {
                  "type": "number"
                },
                "verificationCalls": {
                  "type": "number"
                },
                "freeCases": {
                  "type": "number"
                },
                "available": {
                  "type": "boolean"
                },
                "billedEstimateUsd": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "required": [
                "available",
                "draftVersion",
                "freeCases",
                "modelCalls",
                "quoteId"
              ],
              "additionalProperties": true
            },
            "report": {
              "type": "object",
              "properties": {
                "draftVersion": {
                  "type": "number"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "caseId": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "passed": {
                        "type": "boolean"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "regressionOf": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "caseId",
                      "passed",
                      "status",
                      "type"
                    ],
                    "additionalProperties": true
                  }
                },
                "regressionCount": {
                  "type": "number"
                },
                "allPassed": {
                  "type": "boolean"
                }
              },
              "required": [
                "allPassed",
                "draftVersion",
                "regressionCount",
                "results"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "agentId",
            "quote",
            "report"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
