{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/dev.v1.json",
  "title": "revition dev --json",
  "x-schema-id": "revition.dev.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "dev"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            },
            "session": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string"
                    },
                    "projectId": {
                      "type": "string"
                    },
                    "tier": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    },
                    "resumed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "expiresAt",
                    "projectId",
                    "provider",
                    "resumed",
                    "sessionId",
                    "tier"
                  ],
                  "additionalProperties": true
                }
              ]
            },
            "cycles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "number"
                  },
                  "uploaded": {
                    "type": "number"
                  },
                  "excluded": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "result": {}
                },
                "required": [
                  "excluded",
                  "result",
                  "uploaded",
                  "version"
                ],
                "additionalProperties": true
              }
            },
            "disposed": {
              "type": "boolean"
            },
            "pulled": {
              "type": "number"
            }
          },
          "required": [
            "cycles",
            "disposed",
            "projectId",
            "session"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
