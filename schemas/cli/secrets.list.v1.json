{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/secrets.list.v1.json",
  "title": "revition secrets list --json",
  "x-schema-id": "revition.secrets.list.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "secrets:list"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "enum": [
                "app",
                "workspace"
              ]
            },
            "appId": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "names": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "updatedAt": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "updatedAt"
                ],
                "additionalProperties": true
              }
            },
            "firstSetCost": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "monthlyUsd": {
                      "type": "number"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "monthlyUsd",
                    "note"
                  ],
                  "additionalProperties": true
                }
              ]
            }
          },
          "required": [
            "appId",
            "firstSetCost",
            "names",
            "scope"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
