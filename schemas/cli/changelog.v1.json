{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.revition.com/cli/schemas/changelog.v1.json",
  "title": "revition changelog --json",
  "x-schema-id": "revition.changelog.v1",
  "x-cli-version": "0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "const": "changelog"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "of": {
                  "const": "platform"
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "version": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "added": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "changed": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "deprecated": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "call": {
                              "type": "string"
                            },
                            "removeIn": {
                              "type": "string"
                            },
                            "windowDays": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "call",
                            "removeIn",
                            "windowDays"
                          ],
                          "additionalProperties": true
                        }
                      },
                      "removed": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "added",
                      "changed",
                      "date",
                      "deprecated",
                      "removed",
                      "summary",
                      "version"
                    ],
                    "additionalProperties": true
                  }
                }
              },
              "required": [
                "entries",
                "of"
              ],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "of": {
                  "const": "cli"
                },
                "version": {
                  "type": "string"
                },
                "releasesUrl": {
                  "type": "string"
                }
              },
              "required": [
                "of",
                "releasesUrl",
                "version"
              ],
              "additionalProperties": true
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "cliVersion"
      ],
      "properties": {
        "cliVersion": {
          "type": "string"
        }
      }
    }
  }
}
