{
  "name": "@revition/api-client",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "The typed Revition CLI API client, generated from openapi/v1.json (never hand-edited)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Revition/revition-cli",
    "directory": "packages/api-client"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "node scripts/generate.mjs --check && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
