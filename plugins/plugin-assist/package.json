{
  "name": "@revition/plugin-assist",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "The terminal assistant (assist): the session UX and the local tool executor under the permission policy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Revition/revition-cli",
    "directory": "plugins/plugin-assist"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "oclif.manifest.json",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node ../../packages/cli/scripts/oclif-manifest.mjs .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@oclif/core": "4.11.14",
    "@revition/cli-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "oclif": {
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topicSeparator": " "
  }
}
